{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-repo-domain-harness:storage-adapter-registry:1",
  "title": "Storage Adapter Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapters", "recorded_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition"],
        "properties": {
          "id": { "type": "string", "pattern": "^adapter:[a-z0-9][a-z0-9._-]*$" },
          "definition": { "type": "string", "pattern": "^storage/adapters/[a-z0-9][a-z0-9._-]*\\.json$" }
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} UTC$"
    }
  }
}
