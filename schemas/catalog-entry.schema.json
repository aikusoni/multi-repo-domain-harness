{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-repo-domain-harness:catalog-entry:1",
  "title": "Cross-Space Catalog Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "recorded_at", "representations", "lineage", "public_safety"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^catalog:[a-z0-9][a-z0-9._-]*$" },
    "type": { "type": "string", "minLength": 1 },
    "recorded_at": { "$ref": "#/$defs/utcTimestamp" },
    "representations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/representation" }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "transformation": { "type": "string", "pattern": "^transformation:[a-z0-9][a-z0-9._-]*$" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "public_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed", "classification"],
      "properties": {
        "reviewed": { "type": "boolean" },
        "classification": { "enum": ["public", "public-metadata-only"] }
      }
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} UTC$"
    },
    "safeRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*:(?!/)(?!.*://).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "ref"],
      "properties": {
        "space": { "type": "string", "pattern": "^space:[a-z0-9][a-z0-9._-]*$" },
        "ref": { "$ref": "#/$defs/safeRef" }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "ref"],
      "properties": {
        "space": { "type": "string", "pattern": "^space:[a-z0-9][a-z0-9._-]*$" },
        "ref": { "$ref": "#/$defs/safeRef" },
        "role": { "enum": ["evidence", "record", "projection", "index", "cache"] },
        "valid_from": { "$ref": "#/$defs/utcTimestamp" },
        "valid_until": { "$ref": "#/$defs/utcTimestamp" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
