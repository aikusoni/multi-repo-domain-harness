{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:multi-repo-domain-harness:transformation:1",
  "title": "Storage Transformation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "method",
    "inputs",
    "outputs",
    "preserves",
    "losses",
    "reversible",
    "implementation",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^transformation:[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "method": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpoint" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpoint" } },
    "preserves": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "losses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "reversible": { "type": "boolean" },
    "implementation": {
      "type": "string",
      "oneOf": [
        { "pattern": "^[a-z0-9][a-z0-9._-]*:(?!/)(?!.*://).+$" },
        { "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._*-]+)*$" }
      ]
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} UTC$"
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space", "ref_pattern"],
      "properties": {
        "space": { "type": "string", "pattern": "^space:[a-z0-9][a-z0-9._-]*$" },
        "ref_pattern": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:(?!/)(?!.*://).+$" }
      }
    }
  }
}
